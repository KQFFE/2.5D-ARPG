transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 2.5, 0.05, -0.8)
speaker_name = "The Elder"
body_color = Color(0.68, 0.65, 0.58, 1)
body_scale = 0.92
lines = PackedStringArray("You came in through my door. Few do, these days.", "I have watched that gate since before your mother was born.", "The fields are never quiet now. I hear them at night, scratching at the fence.", "An old man is little use against them. But you - you still have your legs.")
