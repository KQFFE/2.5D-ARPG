[gd_resource type="StyleBoxFlat" format=3]

; Shared menu panel style. Matches res://ui/settings_screen.tscn (same bg color,
; gold 2px border and 8px corner radius) so every menu screen looks the same.

[resource]
content_margin_left = 26.0
content_margin_top = 22.0
content_margin_right = 26.0
content_margin_bottom = 22.0
bg_color = Color(0.07, 0.08, 0.11, 0.96)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.72, 0.63, 0.42, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
